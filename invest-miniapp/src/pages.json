        "pagePath": "pages/overview/overview",
        "text": "总览"
      },
      {
        "pagePath": "pages/summary/summary",
        "text": "统计"
      },
      {
        "pagePath": "pages/trades/trades",
        "text": "流水"
      },
      {
        "pagePath": "pages/signals/signals",
        "text": "信号"
      },
      {
        "pagePath": "pages/settings/settings",
        "text": "我的"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "invest",
    "navigationBarBackgroundColor": "#ffffff",
    "backgroundColor": "#f5f6f7"
